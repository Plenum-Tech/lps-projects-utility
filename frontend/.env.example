# Base URL of the Express backend API.
# Unset -> defaults to http://localhost:5000/api in development.
# Set this when the frontend is served from a different origin than the API.
VITE_API_URL=http://localhost:5000/api

# Optional features (off unless "true"). AI Insights also needs GEMINI_API_KEY + Inngest on the backend.
VITE_FEATURE_AI_INSIGHTS=false
