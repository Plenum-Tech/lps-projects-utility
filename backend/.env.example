# Copy this file to .env and fill in real values. Never commit .env.
# Server
PORT=5000

# Comma-separated list of allowed CORS origins (no spaces)
# e.g. http://localhost:5173,https://app.example.com
CORS_ORIGIN=http://localhost:5173

# Secret used to sign/verify cookies (set a long random string in production)
# e.g. openssl rand -hex 32
COOKIE_SECRET=change-me

# MongoDB connection string (Mongoose)
# NOTE: use the direct (non-SRV) form — SRV/TXT client queries are refused on the dev network (see prompts/mongodb-setup.md)
# Local dev example; use your Atlas URI in .env
MONGO_URI="mongodb://localhost:27017/ems"

# JWT authentication
# Long random string for signing/verifying JWTs (e.g. openssl rand -hex 32)
JWT_SECRET=change-me
# Access token lifetime (ms-style duration, e.g. 7d, 2h, 30m)
JWT_EXPIRES_IN=7d

# Initial admin account created by `bun run seed` (idempotent)
ADMIN_NAME=LPS Admin
ADMIN_EMAIL=admin@ems.local
ADMIN_PASSWORD=change-me-at-least-8-chars

# Frontend URL used for links in emails (e.g. ${APP_URL}/tasks?task=<id>).
# Fallback only: Settings → App Settings → App URL overrides it once set.
APP_URL=http://localhost:5173

# Timezone used for date-only comparisons (reminders, "due today").
# Fallback only: Settings → App Settings → Timezone overrides it once saved.
APP_TIMEZONE=Asia/Kolkata

# Public origin of THIS API, used for the company logo <img> in emails
# (e.g. https://api.example.com). Unset: http://localhost:$PORT in development,
# no logo in emails in production. SVG logos are never embedded in emails.
API_PUBLIC_URL=

# Proxy hops in front of the API (for real client IPs in rate limiting).
# Leave unset: 1 on Vercel, off elsewhere. Set e.g. 1 behind nginx/a load balancer.
TRUST_PROXY=

# Email — Nodemailer over SMTP (SMTP2GO in production). Real values go in .env only.
# If SMTP_HOST, SMTP_USER or SMTP_PASS is missing, emails are skipped (the server still boots).
SMTP_HOST=mail-eu.smtp2go.com
# STARTTLS on 2525 (or 587) → SMTP_SECURE=false; SMTPS on 465 → true
SMTP_PORT=2525
SMTP_SECURE=false
# SMTP2GO: the SMTP user name (not an email address)
SMTP_USER=projectsutility.com
# Mailbox password, or an app password if MFA is on.
# "535 5.7.139" = SMTP AUTH disabled for the mailbox or an app password is required.
SMTP_PASS=
# Sender display name. Leave empty to use the company name from Settings.
FROM_NAME=
# A sender address whose domain is verified in SMTP2GO (SPF include + DKIM CNAMEs)
FROM_EMAIL=support@lps-me.com
# Optional, dev only: deliver ALL mail here (subject prefixed "[to: original@x]")
EMAIL_REDIRECT_TO=

# Master email switch: set EMAIL_ENABLED=false to block ALL outgoing email (even with SMTP set).
EMAIL_ENABLED=true

# Scheduled jobs (reminders, recurring tasks, timers): in-process | inngest | off | dev-loop. Unset = off.
JOBS_MODE=
# Optional, dev only: with SMTP off, log each email that would have been sent (to + subject)
EMAIL_LOG_SKIPPED=false

# AI (optional). Performance reviews are written manually by default.
# AI_REVIEW_DRAFTS=true adds a "Draft with AI" option that sends the employee's
# name, department, period, ratings and past review summaries to Google Gemini.
# Needs GEMINI_API_KEY plus a configured Inngest (INNGEST_EVENT_KEY/INNGEST_SIGNING_KEY,
# or the Inngest dev server locally). If dispatch fails, the review is still created.
AI_REVIEW_DRAFTS=false
# GEMINI_API_KEY=

# Meeting transcripts → "Extract with AI" (optional). Smart hints are rule-based and
# always on; AI extraction sends the transcript text (speaker names + what was said)
# to Google Gemini. Runs synchronously (no Inngest), 60 s timeout. Needs GEMINI_API_KEY.
MEETING_AI_EXTRACTION=false
